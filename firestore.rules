rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'email', 'displayName', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid', 'email', 'displayName', 'createdAt', 'updatedAt'
        ])
        && data.uid == userId
        && data.email == request.auth.token.email
        && data.email is string
        && data.displayName is string
        && data.displayName.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function ownsFolder(folderId) {
      let folderPath = /databases/$(database)/documents/folders/$(folderId);
      return exists(folderPath)
        ? get(folderPath).data.userId == request.auth.uid
        : false;
    }

    function validFolder(data, userId) {
      return data.keys().hasAll([
          'name', 'userId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'name', 'description', 'userId', 'createdAt', 'updatedAt'
        ])
        && data.name is string
        && data.name.size() > 0
        && data.name.size() <= 100
        && data.get('description', '') is string
        && data.get('description', '').size() <= 1000
        && data.userId == userId
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function validNote(data, userId) {
      return data.keys().hasAll([
          'title', 'content', 'folderId', 'userId', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'title', 'content', 'folderId', 'userId', 'summary',
          'keyTopics', 'decisions', 'actionItems', 'createdAt', 'updatedAt'
        ])
        && data.title is string
        && data.title.size() > 0
        && data.title.size() <= 200
        && data.content is string
        && data.content.size() <= 100000
        && data.folderId is string
        && data.folderId.size() > 0
        && data.userId == userId
        && data.get('summary', '') is string
        && data.get('summary', '').size() <= 10000
        && data.get('keyTopics', []) is list
        && data.get('keyTopics', []).size() <= 100
        && data.get('decisions', []) is list
        && data.get('decisions', []).size() <= 100
        && data.get('actionItems', []) is list
        && data.get('actionItems', []).size() <= 100
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow create: if signedInAs(userId)
        && validProfile(request.resource.data, userId);
      allow read: if signedInAs(userId);
      allow update: if signedInAs(userId)
        && validProfile(request.resource.data, userId)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
    }

    match /folders/{folderId} {
      allow create: if request.auth != null
        && validFolder(request.resource.data, request.auth.uid);
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && validFolder(request.resource.data, request.auth.uid)
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /notes/{noteId} {
      allow create: if request.auth != null
        && validNote(request.resource.data, request.auth.uid)
        && ownsFolder(request.resource.data.folderId);
      allow read, delete: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && validNote(request.resource.data, request.auth.uid)
        && request.resource.data.createdAt == resource.data.createdAt
        && ownsFolder(request.resource.data.folderId);
    }

    // Deny every collection until it has explicit owner-scoped rules above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
